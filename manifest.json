{
    "manifest_version": 3,
    "name": "Adaptive Web Buddy",
    "version": "1.0",
    "description": "Make the web accessible for everyone",
    
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    
    "host_permissions": [
        "<all_urls>"
    ],
    
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "Adaptive Web Buddy",
        "default_icon": "accessibility.png"
    },
    "icons":{
        "128": "accessibility.png",
        "64": "accessibility.png",
        "32": "accessibility.png",
        "16": "accessibility.png"
    },
    
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content/contentScript.js"],
            "run_at": "document_start"
        }
    ]
}
