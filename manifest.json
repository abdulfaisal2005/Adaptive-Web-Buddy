{
    "manifest_version": 3,
    "name": "Adaptive Web Buddy",
    "version": "1.0",
    "description": "Make the web accessible for everyone",
    
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    
    "host_permissions": [
        "<all_urls>"
    ],

    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png",
        "256": "icons/icon256.png"
    },
    
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content/contentScript.js"],
            "css": ["content/header.css"],
            "run_at": "document_start"
        }
    ],
    
    "web_accessible_resources": [
        {
            "resources": ["assets/filters.svg", "icons/*"],
            "matches": ["<all_urls>"]
        }
    ]
}
